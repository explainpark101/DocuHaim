    "cropperjs": "2.1.1",
    "dexie": "^4.3.0",
    "embla-carousel-react": "^8.6.0",
    "emoji-mart": "^5.6.0",
    "fflate": "^0.8.3",
    "garu-ko": "^0.9.14",
    "heic2any": "^0.0.4",
    "js-yaml": "^5.2.3",
    "lucide-react": "^0.576.0",
    "lucivy-wasm": "^2.0.1",
    "markdown-it": "15.0.0",
    "md-editor-rt": "^6.3.1",
    "mermaid": "^11.17.0",
    "motion": "^12.43.0",
    "novel": "^1.0.2",
    "protobufjs": "^8.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-aria-components": "^1.20.0",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^6.2.3",
    "react-router": "^7.13.1",
    "tailwindcss": "^4.2.1",
    "tailwindcss-react-aria-components": "^2.2.0",
    "turndown": "^7.2.4",
    "use-fs": "^1.0.0",
    "virtua": "^0.50.0",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.4.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.35.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "markdown-it": "15.0.0",
    "@swc/core": "1.15.47",
    "@swc/wasm": "1.15.47"
  }
}
