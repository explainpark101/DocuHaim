{
  "name": "s3haim",
  "private": true,
  "version": "0.1.1",
  "author": "S3 Haim <explainpark101@gmail.com>",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:icon": "node scripts/rasterize-electron-icon.mjs",
    "build:app": "node scripts/rasterize-electron-icon.mjs && cross-env VITE_ELECTRON=true VITE_BASE_PATH=./ vite build && electron-builder --publish never",
    "lint": "eslint .",
    "preview": "VITE_BASE_PATH=/s3haim vite build && VITE_BASE_PATH=/s3haim vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1001.0",
    "@aws-sdk/core": "^3.973.16",
    "@aws-sdk/s3-request-presigner": "^3.1001.0",
    "@codemirror/view": "^6.39.16",
    "@monaco-editor/react": "^4.7.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@tailwindcss/vite": "^4.2.1",
    "@vavt/cm-extension": "^1.11.2",
    "@vavt/v3-extension": "^4.0.0",
    "dexie": "^4.3.0",
    "lucide-react": "^0.576.0",
    "marked": "^17.0.3",
    "md-editor-rt": "^6.3.1",
    "novel": "^1.0.2",
    "protobufjs": "^8.0.0",
    "react": "^19.2.0",
    "turndown": "^7.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.13.1",
    "tailwindcss": "^4.2.1",
    "use-fs": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0"
  },
  "build": {
    "publish": "never",
    "appId": "com.s3haim.app",
    "productName": "S3 Haim",
    "icon": "build/icon.png",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
