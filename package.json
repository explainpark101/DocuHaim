{
  "name": "docu-haim",
  "private": true,
  "version": "1.8.1",
  "author": "Jaehyung Park <explainpark101@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run llms && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build && bun run docs:build && test -f dist/docs/index.html",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 bun run --cwd docs build",
    "docs:preview": "bun run --cwd docs preview",
    "lint": "eslint .",
    "lint:guard": "eslint . --quiet",
    "lint:app-logic": "eslint --quiet src/App/hooks/use*Domain.ts src/App/hooks/useAppLogicSharedState.ts src/App/hooks/useAppLogicSetupDomain.ts src/App/hooks/appLogicGlue.ts src/App/hooks/autoSaveBridge.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.app-logic.json && bun scripts/check-js-imports.ts",
    "check": "eslint . --quiet && bun run typecheck && bun run test",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "build:image": "bun scripts/generate-og-image.ts",
    "llms": "bun scripts/generate-llms.ts",
    "preview": "VITE_BASE_PATH=/DocuHaim bun run build && VITE_BASE_PATH=/DocuHaim vite preview",
    "start": "bun server/serve.mjs",
    "build:tauri": "bun run sync:tauri-version && bun run llms && cross-env VITE_ELECTRON=true VITE_BASE_PATH=/ NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "tauri": "tauri",
    "tauri:dev": "bun run sync:tauri-version && tauri dev",
    "tauri:build": "bun run sync:tauri-version && tauri build",
    "macos:adhoc": "bun scripts/macos-adhoc-sign.mjs",
    "tauri:macos": "bun run tauri:build && bun run macos:adhoc -- --install",
    "sync:tauri-version": "bun scripts/sync-tauri-version-from-package.mjs",
    "tauri:vite": "cross-env VITE_ELECTRON=true vite",
    "tauri:android:init": "bun scripts/tauri-android.mjs init --ci",
    "tauri:android:dev": "bun run sync:tauri-version && bun scripts/tauri-android.mjs dev",
    "tauri:android:build": "bun run sync:tauri-version && bun scripts/tauri-android.mjs build --apk",
    "tauri:android:build:debug": "bun run sync:tauri-version && bun scripts/tauri-android.mjs build --debug --apk",
    "tauri:cleanup": "rm -rf src-tauri/target && cd src-tauri && cargo clean",
    "//": "clean up the tauri build directory and cache (keep gen/android project and gen/schemas)",
    "cleanup:tauri": "bun run tauri:cleanup"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1001.0",
    "@aws-sdk/core": "^3.973.16",
    "@aws-sdk/s3-request-presigner": "^3.1001.0",
    "@choochmeque/tauri-plugin-biometry-api": "0.2.8",
