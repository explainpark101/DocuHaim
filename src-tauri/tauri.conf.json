{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocuHaim",
  "version": "../package.json",
  "identifier": "com.docuhaim.app",
  "build": {
    "beforeDevCommand": "bun run sync:tauri-version && bun run tauri:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run sync:tauri-version && bun run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DocuHaim",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "acceptFirstMouse": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 18 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Markdown notes with S3 / Local / WebDAV vaults",
    "longDescription": "DocuHaim desktop and Android shell wrapping the same web app for local .md file association and vault editing.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Default",
        "androidIntentActionFilters": ["view", "send", "sendMultiple"]
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "resources": [
      "resources/mlx_vlm_generate_worker.py"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "(^https?://.+)|(^mailto:.+)|(^tel:.+)|(^/.*)|(^[A-Za-z]:[\\\\/].+)"
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3NjJDMTJDQjQ4QTU0M0IKUldRN1ZJcTBMTUZpaDVTdXhhS1N2cnpvdllpTHB6UGR6WkNEeGtkOXRsMEFiaXBUTmp2OFZBb00K",
      "endpoints": [
        "https://github.com/explainpark101/s3haim/releases/latest/download/latest.json"
      ]
    }
  }
}
