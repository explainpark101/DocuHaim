{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "mobile-capability",
  "description": "DocuHaim Android / iOS capability (biometric + Stronghold + local vault fs)",
  "platforms": [
    "android",
    "iOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "shell:default",
    "dialog:default",
    "clipboard-manager:allow-write-text",
    "notification:default",
    "biometric:default",
    "stronghold:default",
    "stronghold:allow-remove-store-record",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-stat",
    "fs:allow-lstat",
    "fs:allow-read-dir",
    "fs:allow-download-write-recursive",
    "fs:allow-download-read-recursive",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPDATA/*"
        },
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$APPLOCALDATA/*"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$APPCACHE/*"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DOCUMENT/*"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOWNLOAD/*"
        },
        {
          "path": "**"
        },
        {
          "path": "**/*"
        }
      ]
    },
    "os:default"
  ]
}