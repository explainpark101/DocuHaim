{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "macos-mlx-lm",
  "description": "DocuHaim macOS MLX-LM shell scopes (uv install, uv tool run)",
  "platforms": ["macOS"],
  "windows": ["main", "s3haim-llm-assist"],
  "permissions": [
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "uv-install",
          "cmd": "/bin/sh",
          "args": ["-lc", "curl -LsSf https://astral.sh/uv/install.sh | sh"]
        },
        {
          "name": "uv-resolve",
          "cmd": "/bin/sh",
          "args": [
            "-lc",
            "for p in \"$HOME/.local/bin/uv\" \"$HOME/.cargo/bin/uv\" \"/opt/homebrew/bin/uv\"; do if [ -x \"$p\" ]; then echo \"$p\"; exit 0; fi; done; command -v uv 2>/dev/null || true"
          ]
        },
        {
          "name": "uv-tool-install-mlx-lm",
          "cmd": "/bin/sh",
          "args": [
            "-lc",
            "exec \"$0\" tool install mlx-lm",
            { "validator": "^(/[A-Za-z0-9._/-]+)/uv$" }
          ]
        },
        {
          "name": "uv-tool-install-hf-hub",
          "cmd": "/bin/sh",
          "args": [
            "-lc",
            "exec \"$0\" tool install huggingface-hub",
            { "validator": "^(/[A-Za-z0-9._/-]+)/uv$" }
          ]
        },
        {
          "name": "uv-tool-run-mlx-server-help",
          "cmd": "/bin/sh",
          "args": [
            "-lc",
            "exec \"$0\" tool run --from mlx-lm mlx_lm.server --help",
            { "validator": "^(/[A-Za-z0-9._/-]+)/uv$" }
          ]
        },
        {
          "name": "uv-tool-run-hf-help",
          "cmd": "/bin/sh",
          "args": [
            "-lc",
            "exec \"$0\" tool run --from huggingface-hub hf --help",
            { "validator": "^(/[A-Za-z0-9._/-]+)/uv$" }
          ]
        },
        {
          "name": "uv-tool-run-hf-download",
          "cmd": "/bin/sh",
          "args": [
            "-lc",
            "exec \"$0\" tool run --from huggingface-hub hf download \"$1\"",
            { "validator": "^(/[A-Za-z0-9._/-]+)/uv$" },
            { "validator": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
          ]
        },
        {
          "name": "uv-tool-run-mlx-convert",
          "cmd": "/bin/sh",
          "args": [
            "-lc",
            "exec \"$0\" tool run --from mlx-lm mlx_lm.convert --model \"$1\" -q",
            { "validator": "^(/[A-Za-z0-9._/-]+)/uv$" },
            { "validator": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
          ]
        },
        {
          "name": "sysctl-memsize",
          "cmd": "sysctl",
          "args": ["-n", "hw.memsize"]
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "mlx-lm-server-uv",
          "cmd": "/bin/sh",
          "args": [
            "-lc",
            "exec \"$0\" tool run --from mlx-lm mlx_lm.server --model \"$1\" --port \"$2\" --host \"$3\"",
            { "validator": "^(/[A-Za-z0-9._/-]+)/uv$" },
            { "validator": ".+" },
            { "validator": "^[0-9]+$" },
            { "validator": "^(127\\.0\\.0\\.1|0\\.0\\.0\\.0|localhost)$" }
          ]
        }
      ]
    }
  ]
}
