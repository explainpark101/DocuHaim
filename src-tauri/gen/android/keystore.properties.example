# Optional override for private release signing (gitignored as keystore.properties).
# Copy to keystore.properties next to this example's parent (gen/android/).
#
# password=your-store-and-key-password
# keyAlias=your-alias
# storeFile=/absolute/path/to/your-keystore.p12
#
# When absent, Gradle uses keystore/docuhaim-sideload.p12 (shared sideload cert).
